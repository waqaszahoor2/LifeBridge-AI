# Copy this file to config/apis.env. Never commit the real file.

# Core environment
APP_ENV=development
DEBUG=false
SECRET_KEY=CHANGE_TO_A_RANDOM_64_CHARACTER_SECRET
ADMIN_API_KEY=CHANGE_TO_A_DIFFERENT_RANDOM_ADMIN_KEY
DATABASE_URL=sqlite:///./lifebridge.db
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
ENABLE_DEMO_SEED=true
ENABLE_SCHEDULER=false

# Default demonstration location
DEFAULT_LATITUDE=31.5204
DEFAULT_LONGITUDE=74.3587
DEFAULT_LOCATION_NAME=Lahore, Pakistan

# No-key official/open sources
NASA_EONET_ENABLED=true
GDACS_ENABLED=true
OPEN_METEO_ENABLED=true
OPENSTREETMAP_ENABLED=true
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
RSS_ENABLED=true
RSS_SOURCES_FILE=config/rss_sources.yaml

# Free registration / approval credentials
RELIEFWEB_ENABLED=false
RELIEFWEB_APP_NAME=
USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# Optional job provider. Review the provider's current plan and terms.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Firebase Cloud Messaging (optional)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=config/secrets/firebase-service-account.json

# Model artifact paths
SCAM_MODEL_PATH=ml/models/scam_classifier.joblib
DISASTER_MODEL_PATH=ml/models/disaster_risk.joblib
SKILL_INDEX_PATH=ml/models/skill_index.joblib

# Refresh intervals
DISASTER_REFRESH_MINUTES=30
WEATHER_REFRESH_MINUTES=60
JOB_REFRESH_MINUTES=360
SCHOLARSHIP_REFRESH_MINUTES=720
SERVICE_CACHE_MINUTES=1440
